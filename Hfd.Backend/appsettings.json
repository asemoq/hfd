{
  "providerOptions": {
    "tgUri": "https://localhost:6001/"
  },
  "ConnectionStrings": {
    "HfdConnection": "Host=localhost;Database=hfd;Username=postgres;Password=postgres",
    "IdentityConnection": "Host=localhost;Database=hfd.users;Username=postgres;Password=postgres"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System": "Information",
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "%ALLUSERSPROFILE%\\HFD\\Logs\\Main\\Hfd.log",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithExceptionDetails"
    ]
  },
  "AllowedHosts": "*"
}

