<?xml version="1.0" encoding="utf-8"?>
<job-scheduling-data version="2.0" xmlns="http://quartznet.sourceforge.net/JobSchedulingData"
                     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <processing-directives>
    <overwrite-existing-data>false</overwrite-existing-data>
    <ignore-duplicates>true</ignore-duplicates>
  </processing-directives>

  <schedule>
      <job>
          <name>ConductTheSurvey:Job</name>
          <group>Approve</group>
          <job-type>Hfd.Common.Backend.Internals.QuartzJobRunner, Hfd.Common.Backend</job-type>
          <durable>false</durable>
      </job>
      <trigger>
          <cron>
              <name>ConductTheSurvey:Trigger:Morning</name>
              <group>Approve</group>
              <job-name>ConductTheSurvey:Job</job-name>
              <job-group>Approve</job-group>
              <misfire-instruction>SmartPolicy</misfire-instruction>
              <cron-expression>0 0 9 * * ? *</cron-expression>
          </cron>
      </trigger>
      <trigger>
          <cron>
              <name>ConductTheSurvey:Trigger:Afternoon</name>
              <group>Approve</group>
              <job-name>ConductTheSurvey:Job</job-name>
              <job-group>Approve</job-group>
              <misfire-instruction>SmartPolicy</misfire-instruction>
              <cron-expression>0 0 14 * * ? *</cron-expression>
          </cron>
      </trigger>
  </schedule>
</job-scheduling-data>