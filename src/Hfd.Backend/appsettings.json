{
  "dataModel": {
    "loadFromAssembly": "Hfd.DbLayer.Pgsql",
    "connectionString": "Host=localhost;Database=hfd;Username=postgres;Password=postgres"
  },
  "Quartz": {
    "quartz.scheduler.instanceName": "JobScheduler",
    "quartz.scheduler.instanceId": "Hfd",
    "quartz.threadPool.threadCount": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System": "Information",
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "%ALLUSERSPROFILE%\\HFD\\Logs\\Main\\Hfd.log",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithExceptionDetails"
    ]
  },
  "AllowedHosts": "*"
}

